\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{core/packages}[2026/10/07 engine-independent packages]


% math related packages
\RequirePackage{mathtools}% enhanced math environments
\RequirePackage{amssymb}% 
\RequirePackage{xfrac}% better fractions
\RequirePackage{stmaryrd}% \llbracket \rrbracket, etc...


% tikz related packages
\RequirePackage{tikz, tikz-cd}% drawing figures and commutative diagrams
\usetikzlibrary{calc}% use tikz calculation library


% graphics
\RequirePackage{graphicx}%


% advanced commenting
\RequirePackage{comment}


% colors
\RequirePackage{xcolor}%


% boxed environments
\RequirePackage[most]{tcolorbox}%


% advanced lists
\RequirePackage{enumitem}%

