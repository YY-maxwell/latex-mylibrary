\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{core/packages}[2026/10/11 Common engine-independent packages]


% ========================================================================
% Math-related packages
% ========================================================================
\RequirePackage{mathtools}% Enhanced math environments.
\RequirePackage{amssymb}
\RequirePackage{mathrsfs}% Script letters.
\RequirePackage{xfrac}% Better fractions.
\RequirePackage{stmaryrd}% \llbracket and \rrbracket.


% ========================================================================
% Colors
% ========================================================================
\RequirePackage{xcolor}


% ========================================================================
% Diagrams
% ========================================================================
\RequirePackage{core/diagrams}


% ========================================================================
% Lists
% ========================================================================
\RequirePackage{enumitem}


% Selective comments
% ========================================================================
% Provides the comment environment and the include/exclude/special comment
% definitions.  The package is engine-independent and is part of the common
% class interface.
\RequirePackage{comment}
