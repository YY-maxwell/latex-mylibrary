  BoldFont={HaranoAjiMincho-Bold.otf},
  ItalicFont={HaranoAjiMincho-Regular.otf},
  ItalicFeatures={FakeSlant=0.2},
  BoldItalicFont={HaranoAjiMincho-Bold.otf},
  BoldItalicFeatures={FakeSlant=0.2}
]{HaranoAjiMincho-Regular.otf}
