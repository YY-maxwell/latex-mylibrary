\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theorem/common}[2026/10/09 Common theorem environment structure]

% This package defines the semantic theorem environment interface.
% It does not create amsthm or tcolorbox environments itself.

\RequirePackage{kvoptions}
\RequirePackage{etoolbox}
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{graphicx}
\RequirePackage{xcolor}

\SetupKeyvalOptions{
  family=mylibtheorem,
  prefix=mylibtheorem@
}
\DeclareStringOption[separate]{numbering}
\DeclareStringOption[section]{numberwithin}
\DeclareStringOption[]{thmnumberwithin}
\DeclareStringOption[]{eqnumberwithin}
\ProcessKeyvalOptions*

\makeatletter

% ------------------------------------------------------------------------
% Display names.
% A future language package can redefine these commands without copying the theorem styles or backend implementation.
% ------------------------------------------------------------------------
\newcommand{\mylib@theoremname@definition}{Definition}
\newcommand{\mylib@theoremname@theorem}{Theorem}
\newcommand{\mylib@theoremname@proposition}{Proposition}
\newcommand{\mylib@theoremname@lemma}{Lemma}
\newcommand{\mylib@theoremname@corollary}{Corollary}
\newcommand{\mylib@theoremname@example}{Example}
\newcommand{\mylib@theoremname@remark}{Remark}
\newcommand{\mylib@theoremname@notation}{Notation}
\newcommand{\mylib@theoremname@proof}{Proof.}

% The theorem styles use this command for the heading font.
% Language-specific theorem packages may redefine it before a style is materialized.
\newcommand{\mylibtheoremheadfont}{\bfseries}
\newcommand{\mylibtheoremnotefont}{}
\newcommand{\mylibtheoremnote}[1]{{\mylibtheoremnotefont #1}}
\newcommand{\mylibtheoremreffont}[1]{#1}
\newcommand{\parenref}[1]{\mylibtheoremreffont{(\ref{#1})}}

% The proof environments in both backends use the same manually inserted QED symbol.
% Each backend binds the public \qed command after loading its own implementation package, because amsthm provides \qedsymbol while the tcolorbox backend does not.
\newcommand{\mylib@defaultqedsymbol}{%
  \textcolor{gray}{\scalebox{.5}[1]{$\blacksquare$}}%
}

% A single numberwithin option is the usual case.
% The two more specific options override it only when a document needs different reset units for theorem and equation counters.
\ifdefempty{\mylibtheorem@thmnumberwithin}{%
  \edef\mylib@thmnumberwithin{\mylibtheorem@numberwithin}
}{%
  \edef\mylib@thmnumberwithin{\mylibtheorem@thmnumberwithin}
}
\ifdefempty{\mylibtheorem@eqnumberwithin}{%
  \edef\mylib@eqnumberwithin{\mylibtheorem@numberwithin}
}{%
  \edef\mylib@eqnumberwithin{\mylibtheorem@eqnumberwithin}
}

% Equation numbering is common to both theorem backends.
\newcommand{\mylib@applyequationnumbering}{%
  \ifdefstring{\mylib@eqnumberwithin}{section}{%
    \numberwithin{equation}{section}%
  }{%
    \ifdefstring{\mylib@eqnumberwithin}{subsection}{%
      \numberwithin{equation}{subsection}%
    }{%
      \renewcommand{\theequation}{\arabic{equation}}%
    }%
  }%
}
\mylib@applyequationnumbering

\newcommand{\mylib@theoremname}[1]{%
  \csname mylib@theoremname@#1\endcsname
}

\makeatother

\endinput
