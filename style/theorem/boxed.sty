\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theorem/boxed}[2026/10/09 Boxed theorem appearance]

% This package defines the complete tcolorbox appearance of each semantic theorem environment.
% It does not define the public environments; theorem/backend-tcolorbox.sty does that.

\RequirePackage{theorem/common}
\RequirePackage{tcolorbox}
\RequirePackage{boxstyle/westruled}
\RequirePackage{boxstyle/simpleboxed}
\RequirePackage{boxstyle/plain}
\RequirePackage{boxstyle/proofstyle}

\makeatletter

% The tcolorbox backend uses this registry for complete option lists.
\newcommand{\mylib@theoremoptions@definition}{}
\newcommand{\mylib@theoremoptions@theorem}{}
\newcommand{\mylib@theoremoptions@proposition}{}
\newcommand{\mylib@theoremoptions@lemma}{}
\newcommand{\mylib@theoremoptions@corollary}{}
\newcommand{\mylib@theoremoptions@example}{}
\newcommand{\mylib@theoremoptions@remark}{}
\newcommand{\mylib@theoremoptions@notation}{}
\newcommand{\mylib@theoremoptions@proof}{}

\newcommand{\mylib@registertheoremoptions}[2]{%
  \expandafter\def\csname mylib@theoremoptions@#1\endcsname{#2}%
}

\newcommand{\mylib@theoremoptions}[1]{%
  \csname mylib@theoremoptions@#1\endcsname
}

% The names below are internal tcolorbox styles.
% The complete appearance is kept here, rather than being spread over the backend environment definitions.
\tcbset{mylib/definition/.style={%
  westruled,
  line color=black,
  separator sign={},
  fonttitle=\mylibtheoremheadfont,
  before skip=5pt,
  after skip=5pt,
  before upper={\tcbtitle\textbf{.}\;}
}}

\tcbset{mylib/theorem/.style={%
  simpleboxed,
  separator sign={},
  fonttitle=\mylibtheoremheadfont,
  fontupper=\itshape,
  before skip=5pt,
  after skip=5pt
}}
\tcbset{mylib/proposition/.style={%
  simpleboxed,
  separator sign={},
  fonttitle=\mylibtheoremheadfont,
  fontupper=\itshape,
  before skip=5pt,
  after skip=5pt
}}
\tcbset{mylib/lemma/.style={%
  simpleboxed,
  separator sign={},
  fonttitle=\mylibtheoremheadfont,
  fontupper=\itshape,
  before skip=5pt,
  after skip=5pt
}}
\tcbset{mylib/corollary/.style={%
  simpleboxed,
  separator sign={},
  fonttitle=\mylibtheoremheadfont,
  fontupper=\itshape,
  before skip=5pt,
  after skip=5pt
}}

\tcbset{mylib/example/.style={%
  plain,
  separator sign={},
  fonttitle=\mylibtheoremheadfont,
  before upper={\tcbtitle\textbf{.}\;}
}}
\tcbset{mylib/remark/.style={%
  plain,
  fonttitle=\mylibtheoremheadfont,
  before upper={\tcbtitle\;}
}}
\tcbset{mylib/notation/.style={%
  plain,
  fonttitle=\mylibtheoremheadfont,
  before upper={\tcbtitle\;}
}}

\tcbset{mylib/proof/.style={%
  proofstyle,
  line color=gray
}}

% Register only the style names.
% The backend does not need to know the individual visual settings.
\mylib@registertheoremoptions{definition}{mylib/definition}
\mylib@registertheoremoptions{theorem}{mylib/theorem}
\mylib@registertheoremoptions{proposition}{mylib/proposition}
\mylib@registertheoremoptions{lemma}{mylib/lemma}
\mylib@registertheoremoptions{corollary}{mylib/corollary}
\mylib@registertheoremoptions{example}{mylib/example}
\mylib@registertheoremoptions{remark}{mylib/remark}
\mylib@registertheoremoptions{notation}{mylib/notation}
\mylib@registertheoremoptions{proof}{mylib/proof}

\makeatother

\endinput
