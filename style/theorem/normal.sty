\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theorem/normal}[2026/10/09 Normal theorem appearance]

% The normal profile uses the standard theorem styles provided by amsthm.
% The actual environments are created by theorem/backend-amsthm.sty.

\RequirePackage{theorem/common}
\RequirePackage{amsthm}

\makeatletter

% Numbered theorem-like environments:
%   (2.1) Definition Optional title
% The complete heading is bold; the body remains upright for definitions and
% examples, and italic for theorem-like assertions.
\newtheoremstyle{mylibdefinition}%
  {}{}{\upshape}{}{\bfseries}{}{5pt plus 1pt minus 1pt}%
  {\thmnumber{(#2)}\thmname{ #1}\thmnote{ #3}}

\newtheoremstyle{mylibtheorem}%
  {}{}{\itshape}{}{\bfseries}{}{5pt plus 1pt minus 1pt}%
  {\thmnumber{(#2)}\thmname{ #1}\thmnote{ #3}}

\newtheoremstyle{mylibremark}%
  {}{}{\upshape}{}{\bfseries}{}{5pt plus 1pt minus 1pt}%
  {\thmname{#1}\thmnote{ #3}}

\mylib@registertheoremstyle{definition}{mylibdefinition}
\mylib@registertheoremstyle{theorem}{mylibtheorem}
\mylib@registertheoremstyle{proposition}{mylibtheorem}
\mylib@registertheoremstyle{lemma}{mylibtheorem}
\mylib@registertheoremstyle{corollary}{mylibtheorem}
\mylib@registertheoremstyle{example}{mylibdefinition}
\mylib@registertheoremstyle{remark}{mylibremark}
\mylib@registertheoremstyle{notation}{mylibremark}

\makeatother

\endinput
