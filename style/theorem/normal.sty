\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theorem/normal}[2026/10/09 Normal theorem appearance]

% The normal profile uses the standard theorem styles provided by amsthm.
% The actual environments are created by theorem/backend-amsthm.sty.

\RequirePackage{theorem/common}
\RequirePackage{amsthm}

\makeatletter

% The amsthm backend uses this registry for named theorem styles.
\newcommand{\mylib@theoremstyle@definition}{}
\newcommand{\mylib@theoremstyle@theorem}{}
\newcommand{\mylib@theoremstyle@proposition}{}
\newcommand{\mylib@theoremstyle@lemma}{}
\newcommand{\mylib@theoremstyle@corollary}{}
\newcommand{\mylib@theoremstyle@example}{}
\newcommand{\mylib@theoremstyle@remark}{}
\newcommand{\mylib@theoremstyle@notation}{}

\newcommand{\mylib@registertheoremstyle}[2]{%
  \expandafter\def\csname mylib@theoremstyle@#1\endcsname{#2}%
}

\newcommand{\mylib@theoremstyle}[1]{%
  \csname mylib@theoremstyle@#1\endcsname
}

% Numbered theorem-like environments: (2.1) Definition Optional title.
% The complete heading is bold; the body remains upright for definitions and examples.
\newtheoremstyle{mylibdefinition}%
  {10pt}{10pt}{\upshape}{}{\mylibtheoremheadfont}{}{5pt plus 1pt minus 1pt}%
  {\thmnumber{(#2)}\thmname{ #1}\thmnote{ \mylibtheoremnote{#3}}}

\newtheoremstyle{mylibtheorem}%
  {10pt}{10pt}{\mylibtheorembodyfont}{}{\mylibtheoremheadfont}{}{5pt plus 1pt minus 1pt}%
  {\thmnumber{(#2)}\thmname{ #1}\thmnote{ \mylibtheoremnote{#3}}}

\newtheoremstyle{mylibremark}%
  {}{}{\upshape}{}{\mylibtheoremheadfont}{}{5pt plus 1pt minus 1pt}%
  {\thmname{#1}\thmnote{ \mylibtheoremnote{#3}}}

\mylib@registertheoremstyle{definition}{mylibdefinition}
\mylib@registertheoremstyle{theorem}{mylibtheorem}
\mylib@registertheoremstyle{proposition}{mylibtheorem}
\mylib@registertheoremstyle{lemma}{mylibtheorem}
\mylib@registertheoremstyle{corollary}{mylibtheorem}
\mylib@registertheoremstyle{example}{mylibdefinition}
\mylib@registertheoremstyle{remark}{mylibremark}
\mylib@registertheoremstyle{notation}{mylibremark}

\makeatother

\endinput
