\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{theorem/backend-amsthm}[2026/10/11 amsthm theorem backend]

% This backend materializes the semantic theorem interface using amsthm. theorem/normal.sty must be loaded first so that theorem styles are registered.

\RequirePackage{theorem/common}
\RequirePackage{amsthm}

\makeatletter

% Do not use amsthm's automatic QED mechanism.
% The document author writes \qed explicitly, just as with the tcolorbox backend.
% Keep the symbol configurable through the public \qedsymbol command.
\renewcommand{\qedsymbol}{\mylib@defaultqedsymbol}
\renewcommand{\qed}{\nobreak\hspace{1em}\qedsymbol}

\theoremstyle{\mylib@theoremstyle{definition}}
\ifdefstring{\mylibtheorem@numbering}{shared}{%
  \newtheorem{definition}[equation]{\mylib@theoremname{definition}}%
}{%
  \ifdefstring{\mylib@thmnumberwithin}{section}{%
    \newtheorem{definition}{\mylib@theoremname{definition}}[section]%
    \renewcommand{\thedefinition}{\thesection.\arabic{definition}}%
  }{%
    \ifdefstring{\mylib@thmnumberwithin}{subsection}{%
      \newtheorem{definition}{\mylib@theoremname{definition}}[subsection]%
      \renewcommand{\thedefinition}{\thesubsection.\arabic{definition}}%
    }{%
      \newtheorem{definition}{\mylib@theoremname{definition}}%
      \renewcommand{\thedefinition}{\arabic{definition}}%
    }%
  }%
}

% Unnumbered starred forms use the same styles and display names as their
% numbered counterparts.  They do not create or advance a counter.
\newtheorem*{definition*}{\mylib@theoremname{definition}}

\theoremstyle{\mylib@theoremstyle{theorem}}
\ifdefstring{\mylibtheorem@numbering}{shared}{%
  \newtheorem{theorem}[equation]{\mylib@theoremname{theorem}}
  \newtheorem{proposition}[equation]{\mylib@theoremname{proposition}}
  \newtheorem{lemma}[equation]{\mylib@theoremname{lemma}}
  \newtheorem{corollary}[equation]{\mylib@theoremname{corollary}}
}{%
  \newtheorem{theorem}[definition]{\mylib@theoremname{theorem}}
  \newtheorem{proposition}[definition]{\mylib@theoremname{proposition}}
  \newtheorem{lemma}[definition]{\mylib@theoremname{lemma}}
  \newtheorem{corollary}[definition]{\mylib@theoremname{corollary}}
}
\newtheorem*{theorem*}{\mylib@theoremname{theorem}}
\newtheorem*{proposition*}{\mylib@theoremname{proposition}}
\newtheorem*{lemma*}{\mylib@theoremname{lemma}}
\newtheorem*{corollary*}{\mylib@theoremname{corollary}}

\theoremstyle{\mylib@theoremstyle{example}}
\ifdefstring{\mylibtheorem@numbering}{shared}{%
  \newtheorem{example}[equation]{\mylib@theoremname{example}}
}{%
  \newtheorem{example}[definition]{\mylib@theoremname{example}}
}
\newtheorem*{example*}{\mylib@theoremname{example}}

% amsthm steps the shared counter inside \@thm.  Set the reference type
% immediately after each public environment begins, including optional titles.
\ifdefstring{\mylibtheorem@numbering}{shared}{%
  \def\mylib@amsthmcounter{equation}%
}{%
  \def\mylib@amsthmcounter{definition}%
}
\newcommand{\mylib@aliasamsthmcounter}[1]{%
  \csletcs{c@#1}{c@\mylib@amsthmcounter}%
  \csletcs{p@#1}{p@\mylib@amsthmcounter}%
  \ifdefstring{\mylib@thmnumberwithin}{section}{%
    \@addtoreset{#1}{section}%
  }{%
    \ifdefstring{\mylib@thmnumberwithin}{subsection}{%
      \@addtoreset{#1}{subsection}%
    }{}%
  }%
}
\mylib@aliasamsthmcounter{definition}
\mylib@aliasamsthmcounter{theorem}
\mylib@aliasamsthmcounter{proposition}
\mylib@aliasamsthmcounter{lemma}
\mylib@aliasamsthmcounter{corollary}
\mylib@aliasamsthmcounter{example}

\let\mylib@begindefinition\definition
\let\mylib@enddefinition\enddefinition
\RenewDocumentEnvironment{definition}{o}
  {\IfValueTF{#1}{\mylib@begindefinition[#1]}{\mylib@begindefinition}%
   \mylib@setcreftype{definition}}
  {\mylib@enddefinition}

\let\mylib@begintheorem\theorem
\let\mylib@endtheorem\endtheorem
\RenewDocumentEnvironment{theorem}{o}
  {\IfValueTF{#1}{\mylib@begintheorem[#1]}{\mylib@begintheorem}%
   \mylib@setcreftype{theorem}}
  {\mylib@endtheorem}

\let\mylib@beginproposition\proposition
\let\mylib@endproposition\endproposition
\RenewDocumentEnvironment{proposition}{o}
  {\IfValueTF{#1}{\mylib@beginproposition[#1]}{\mylib@beginproposition}%
   \mylib@setcreftype{proposition}}
  {\mylib@endproposition}

\let\mylib@beginlemma\lemma
\let\mylib@endlemma\endlemma
\RenewDocumentEnvironment{lemma}{o}
  {\IfValueTF{#1}{\mylib@beginlemma[#1]}{\mylib@beginlemma}%
   \mylib@setcreftype{lemma}}
  {\mylib@endlemma}

\let\mylib@begincorollary\corollary
\let\mylib@endcorollary\endcorollary
\RenewDocumentEnvironment{corollary}{o}
  {\IfValueTF{#1}{\mylib@begincorollary[#1]}{\mylib@begincorollary}%
   \mylib@setcreftype{corollary}}
  {\mylib@endcorollary}

\let\mylib@beginexample\example
\let\mylib@endexample\endexample
\RenewDocumentEnvironment{example}{o}
  {\IfValueTF{#1}{\mylib@beginexample[#1]}{\mylib@beginexample}%
   \mylib@setcreftype{example}}
  {\mylib@endexample}

\theoremstyle{\mylib@theoremstyle{remark}}
\newtheorem*{remark}{\mylib@theoremname{remark}}
\newtheorem*{notation}{\mylib@theoremname{notation}}

\renewenvironment{proof}[1][\mylib@theoremname{proof}]{%
  \par
  \normalfont
  \topsep10\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep\emph{#1}]\ignorespaces
}{%
  \endtrivlist\@endpefalse
}

\makeatother

\endinput
