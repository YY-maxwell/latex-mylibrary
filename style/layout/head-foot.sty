\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{layout/head-foot}[2026/10/08 Page styles for notes, papers, and seminars]


\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}

\makeatletter

% Keep section marks readable in headers and provide a subsection mark for
% article-like classes.
\patchcmd{\sectionmark}{\MakeUppercase}{}{}{}
\renewcommand{\subsectionmark}[1]{\markright{\thesubsection\ #1}}

% Text displayed in the centered header of the paper and seminar styles.
\newcommand{\paperheader}[1]{\def\headfoot@paperheader{#1}}
\newcommand{\seminarheader}[1]{\def\headfoot@seminarheader{#1}}
\paperheader{}
\seminarheader{\leftmark}

% Notes: section and subsection in the header, page number in the footer.
\fancypagestyle{notes}{%
  \fancyhf{}%
  \fancyhead[L]{\leftmark}%
  \fancyhead[R]{\rightmark}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0.3pt}%
  \setlength{\headheight}{18pt}%
  \setlength{\headwidth}{\textwidth}%
}

% Paper: page numbers at the outer top corners and a configurable centered
% running header. This style is intended for two-sided documents.
\fancypagestyle{paper}{%
  \if@twoside\else
    \PackageError{layout/head-foot}%
      {The paper page style requires the twoside class option}%
      {Use \string\documentclass[twoside]{normal} before selecting the paper page style.}%
  \fi
  \fancyhf{}%
  \fancyhead[LE,RO]{\thepage}%
  \fancyhead[CE,CO]{\headfoot@paperheader}%
  \renewcommand{\headrulewidth}{0.3pt}%
  \setlength{\headheight}{18pt}%
  \setlength{\headwidth}{\textwidth}%
}

% Seminar: configurable centered header and centered page number in the
% footer. The default header is the current section mark.
\fancypagestyle{seminar}{%
  \fancyhf{}%
  \fancyhead[C]{\headfoot@seminarheader}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0.3pt}%
  \setlength{\headheight}{18pt}%
  \setlength{\headwidth}{\textwidth}%
}

\makeatother

% Preserve the former default for documents that load this package without
% selecting another style explicitly.
\pagestyle{notes}

