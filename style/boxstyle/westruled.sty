\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{boxstyle/westruled}[2025/05/10 westruled style]

\tcbuselibrary{skins}

\pgfkeys{
    /tcb/westruledlinewidth/.store in=\tcbwestruledlinewidth,
    /tcb/westruledlinewidth=2pt
}

\tcbset{
    % 左側に線を引く
    westruled/.style = {
        enhanced,% tikz系のコマンドに必要(overlay)
        detach title,% タイトルボックスを削除
        frame hidden,% 枠線を消去
        boxrule=0pt,
        sharp corners,% 角を直角
        colback = white,
        coltitle = black,
        boxsep = 0pt,
        left = 3.5mm,
        right = 3.5mm,
        borderline west={
            \tcbwestruledlinewidth
        }{0pt}{\tcbcol@overlay},
        line color/.store in=\tcbcol@overlay,
        line color=gray,% default
    }
}
