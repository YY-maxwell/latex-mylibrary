{
  // Settings for compiling the library's own test documents.
  // Select the engine explicitly because the test classes use different engines.
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/vscode",
  "latex-workshop.latex.recipe.default": "latexmk-lualatex",
  "latex-workshop.latex.autoBuild.run": "never",

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdflatex",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk-lualatex",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk-xelatex",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk-pdflatex",
      "tools": ["latexmk-pdflatex"]
    },
    {
      "name": "latexmk-lualatex",
      "tools": ["latexmk-lualatex"]
    },
    {
      "name": "latexmk-xelatex",
      "tools": ["latexmk-xelatex"]
    }
  ]
}
